# Copy this file to .env.production on your DigitalOcean droplet.
# Values here are safe dummy placeholders; do not put real secrets in git.
APP_ENV_FILE=.env.example

# Public deployment
PUBLIC_APP_URL=https://advocateai.example.com
PUBLIC_API_BASE_URL=https://advocateai.example.com/api
CORS_ALLOWED_ORIGINS=https://advocateai.example.com
CORS_ALLOW_ORIGIN_REGEX=
LOG_LEVEL=INFO

# Backend database connection
DB_HOST=db
DB_PORT=5432
DB_NAME=advocateai
DB_USER=advocateai
DB_PASSWORD=replace-with-a-long-random-password
DB_CONNECT_TIMEOUT=5

# Postgres container bootstrap.
# Keep these aligned with DB_NAME, DB_USER, and DB_PASSWORD above.
POSTGRES_DB=advocateai
POSTGRES_USER=advocateai
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Redis cache/rate-limit container
REDIS_HOST=redis
REDIS_PORT=6379

# AI providers
GOOGLE_API_KEY=replace-with-google-api-key
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_DEFAULT_TIMEOUT=20
GEMINI_ANALYSIS_TIMEOUT=35
GEMINI_BRIEF_TIMEOUT=25
GEMINI_CHAT_TIMEOUT=25
GEMINI_DOCUMENT_TIMEOUT=30

# Optional MLOps tracking
MLOPS_ENABLED=false
MLOPS_LOG_PROMPTS=false
MLFLOW_ENABLED=false
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=AdvocateAI
WANDB_ENABLED=false
WANDB_PROJECT=AdvocateAI
WANDB_ENTITY=
WANDB_MODE=offline

# Pre-built Docker images (set by CI/CD, pulled from ghcr.io)
BACKEND_IMAGE=ghcr.io/iamvisheshsrivastava/advocateai-backend:latest
FRONTEND_IMAGE=ghcr.io/iamvisheshsrivastava/advocateai-frontend:latest
